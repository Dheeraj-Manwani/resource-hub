# Copy to .env and fill in. See README for setup details.

# Postgres (docker compose maps the container to host port 5433)
DATABASE_URL=postgres://resource:resource@localhost:5433/resource

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (authorized redirect URI: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (private bucket; required for uploads and thumbnail snapshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional upload limits in MB
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_FILE_MB=50

# Protects /api/cron/* (required in production)
CRON_SECRET=

# Optional metadata API keys
GITHUB_TOKEN=
YOUTUBE_API_KEY=
META_OEMBED_TOKEN=

# Target user for `pnpm db:seed` (must have signed in once)
SEED_USER_EMAIL=
